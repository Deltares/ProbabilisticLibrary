<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="$(ProjectDir)..\utils\Product.targets" />
    <Import Project="$(ProjectDir)..\utils\Package.targets" />
    <!-- Packaging only: the metapackage under the original package ID, so existing users keep working.
         No code and no files; its project references become the (exactly pinned) package dependencies. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Platforms>x64</Platforms>
        <EnableDefaultItems>false</EnableDefaultItems>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <!-- NU5128: no lib folder, which is intended for a metapackage. -->
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <PackageId>Deltares.Probabilistic.Library</PackageId>
        <Description>.Net interface for Probabilistic Library. Metapackage referencing Deltares.ProbabilisticLibrary.Core, Deltares.ProbabilisticLibrary.Optimization and Deltares.ProbabilisticLibrary.Probabilistic.</Description>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Deltares.Probabilistic.NetCS.Core\Deltares.Probabilistic.NetCS.Core.csproj" />
        <ProjectReference Include="..\Deltares.Probabilistic.NetCS.Optimization\Deltares.Probabilistic.NetCS.Optimization.csproj" />
        <ProjectReference Include="..\Deltares.Probabilistic.NetCS.Probabilistic\Deltares.Probabilistic.NetCS.Probabilistic.csproj" />
    </ItemGroup>
</Project>
